{
  "name": "powertools-x402",
  "version": "0.1.0",
  "description": "x402 payment middleware for AWS Lambda Powertools Event Handler",
  "license": "MIT",
  "author": "Allen Helton <allenheltondev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenheltondev/powertools-x402.git"
  },
  "keywords": [
    "x402",
    "payments",
    "aws-lambda",
    "powertools",
    "middleware",
    "serverless"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/**",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@aws-lambda-powertools/event-handler": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0"
  },
  "devDependencies": {
    "@aws-lambda-powertools/event-handler": "^2.35.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "viem": "^2.48.0",
    "vitest": "^3.0.0"
  }
}
